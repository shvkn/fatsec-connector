NODE_ENV=development
PORT=8080
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgresql://fatsecret:fatsecret@localhost:5432/fatsecret
DATABASE_SSL=false
# For strict TLS verification, store the PEM certificate with literal \n escapes.
DATABASE_CA_CERT=

# FatSecret OAuth 1.0 credentials from https://platform.fatsecret.com/api/
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=

# Generate each value with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

# Password for the management interface.
ADMIN_PASSWORD=
